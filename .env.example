# ============ 模型供应商 ============
# deepseek（官方：https://platform.deepseek.com/） 或 qwen（通义百炼：https://bailian.console.aliyun.com/）
LLM_PROVIDER=deepseek

# 你的 API Key（必填，真实运行时）
API_KEY=sk-xxxxxxxxxxxxxxxx

# deepseek 默认 https://api.deepseek.com/v1 ；qwen 用 https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# ============ RAG ============
# 语料路径：换成你自己的文档（.md / .txt，UTF-8）
CORPUS_PATH=data/sample_doc.md
# 切片大小（字符）与重叠——调优的第一组变量
CHUNK_SIZE=300
CHUNK_OVERLAP=50
# 检索返回片段数
TOP_K=3

# ============ Agent ============
# ReAct 最大步数（防死循环）
MAX_STEPS=5

# 1=无 Key 演示模式（MockLLM，不发真实请求）
MOCK_MODE=0
